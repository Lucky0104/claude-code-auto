# ===========================================================================
# Next.js web app (apps/web). Copy to apps/web/.env.local for local dev.
# ===========================================================================

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. NEVER expose. Used by Server Actions / Route Handlers.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Database (Prisma) ----
# Pooled connection (PgBouncer) for the app; direct connection for migrations.
DATABASE_URL=postgresql://postgres:password@db.YOUR-PROJECT.supabase.co:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:password@db.YOUR-PROJECT.supabase.co:5432/postgres

# ---- Meta / Facebook Graph API ----
FB_GRAPH_VERSION=v21.0
FB_APP_ID=
FB_APP_SECRET=
# Token used to verify the Meta webhook subscription handshake.
FB_WEBHOOK_VERIFY_TOKEN=choose-a-verify-token

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Per-tenant campaign-sync cooldown, seconds (0 disables).
SYNC_RATE_LIMIT_SECONDS=15

# ---- Observability ----
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
