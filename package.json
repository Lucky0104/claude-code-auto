{
  "name": "claude-code-auto",
  "private": true,
  "version": "1.0.0",
  "description": "Instagram Comment Automation SaaS — Next.js 15 / Supabase / Prisma / Cloudflare Workers",
  "workspaces": [
    "apps/*",
    "workers/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "start": "npm run start --workspace apps/web",
    "lint": "npm run lint --workspace apps/web",
    "test": "npm run test --workspace apps/web",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "postinstall": "prisma generate --schema prisma/schema.prisma || true"
  },
  "devDependencies": {
    "prisma": "5.22.0",
    "typescript": "5.6.3"
  },
  "dependencies": {
    "@prisma/client": "5.22.0"
  },
  "engines": {
    "node": ">=20"
  }
}
